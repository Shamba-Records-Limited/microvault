{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3000 --host",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "type-check": "tsc --noEmit --skipLibCheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt src",
    "fmt:check": "vp fmt --check src",
    "check": "vp lint && vp fmt --check src",
    "fix": "vp lint --fix && vp fmt src",
    "clean:output": "rimraf dist",
    "clean:modules": "rimraf package-lock.json node_modules",
    "clean:all": "rimraf dist package-lock.json node_modules"
  },
  "dependencies": {
    "@creit-tech/stellar-wallets-kit": "npm:@jsr/creit-tech__stellar-wallets-kit@^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stellar/stellar-sdk": "^17.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.3",
    "@tanstack/react-router": "^1.170.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.3.0",
    "in": "^0.19.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "web": "^0.0.2",
    "vite-plus": "1.8.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "allowScripts": {
    "@reown/appkit@1.8.21": true,
    "@stellar/stellar-sdk@14.2.0": true,
    "protobufjs@7.4.0": true,
    "protobufjs@7.5.5": true,
    "blake-hash@2.0.0": true,
    "bufferutil@4.1.0": true,
    "secp256k1@5.0.1": true,
    "tiny-secp256k1@1.1.7": true,
    "usb@2.18.0": true,
    "utf-8-validate@6.0.6": true,
    "@stellar/stellar-sdk@16.1.0": true
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001"
  }
}
