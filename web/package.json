{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit --skipLibCheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "check": "oxlint && oxfmt --check src",
    "fix": "oxlint --fix && oxfmt src",
    "clean:output": "rimraf dist",
    "clean:modules": "rimraf package-lock.json node_modules",
    "clean:all": "rimraf dist package-lock.json node_modules"
  },
  "dependencies": {
    "@creit-tech/stellar-wallets-kit": "npm:@jsr/creit-tech__stellar-wallets-kit@^2.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stellar/stellar-sdk": "^16.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.76.0",
    "shadcn": "^4.14.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
